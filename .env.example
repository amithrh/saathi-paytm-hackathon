# Sarvam AI (required): speech-to-text, text-to-speech, LLM
SARVAM_API_KEY=

# Twilio (optional, for the real phone call). Leave empty to use the browser call screen only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The judge's (or your) phone, E.164, e.g. +919900000000. Must be verified in a Twilio trial account.
DEMO_PHONE_NUMBER=
# Public HTTPS URL of this server for Twilio webhooks, e.g. https://abc123.ngrok.app (ngrok http 3000)
PUBLIC_BASE_URL=

# WhatsApp via the Twilio WhatsApp Sandbox (same account). Leave empty to keep the reminder mocked on the dashboard.
# Sandbox sender is whatsapp:+14155238886. One-time step: from EACH receiving phone, send "join <your-sandbox-code>"
# (shown in Twilio console > Messaging > Try it out > Send a WhatsApp message) to +1 415 523 8886. Lasts 72 hours.
TWILIO_WHATSAPP_FROM=
# The phone that plays Suresh and receives the real reminder, E.164, e.g. +919900000000
SURESH_PHONE_NUMBER=
# Optional, same for the Kannada demo's Manjunath
# MANJUNATH_PHONE_NUMBER=

# Demo knobs (optional)
# Pin the clock so compliance calling hours (09:00-21:00 IST) pass when rehearsing at night.
# SAATHI_FAKE_NOW=2026-10-31T10:15:00+05:30
# Seconds after a reminder before the mock customer pays (ms). 0 disables.
# SIMULATED_PAYMENT_DELAY_MS=25000
# Server port
# PORT=3000
