{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["backend/**/*.ts", "agent/**/*.ts", "voice/**/*.ts", "twilio/**/*.ts", "whatsapp/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "deck-src"]
}
